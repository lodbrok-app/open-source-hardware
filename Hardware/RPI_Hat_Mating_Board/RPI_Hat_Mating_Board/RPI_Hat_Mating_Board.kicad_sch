	(text "Max rise-time / input capacitance of concern\nDirection of input/output also a concern"
		(exclude_from_sim no)
		(at -21.336 846.074 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "28ecde22-7554-48ed-917d-613eaef138ba")
	)
	(text "Decoupling Caps:\n\n\"Apply 100-nF to 220-nF decoupling capacitors \nas close as possible to the VCC pins of transceiver, \nUART and/or controller ICs on the board.\" (Pg. 29)\n"
		(exclude_from_sim no)
		(at -14.986 479.552 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3d485c7c-496d-48c6-8701-72ea2e59feaf")
	)
	(text "*****NOTES*****\n\nSHIFT REGISTERS:\nCS line switching speed will be limited if shift register is used. We \nwould not be able to switch between different adcs quickly enough if\nwe wanted to swap through several of them to see their data but at the\nexpense of lower sampling speed.\n\nDE-MULTIPLEXING:\nfaster CS selection (10-15 ns), this will not be the bottleneck if we\nwant to switch between sampling different adcs.\n\nCLOCK TRANSMISSION:\nthe RPI will output a clock signal. This clock trace must be close \nto the 8 recieving pins on the quad RS-422 drivers to keep the\ncapacitance low and the clock edges sharp.\n"
		(exclude_from_sim no)
		(at -232.41 129.794 0)
		(effects
			(font
				(size 3.81 3.81)
			)
			(justify left)
		)
		(uuid "50ec4476-42b8-4244-ace9-1c7ba47e4870")
	)
	(text "Note: I am always sending the clock to the ADCs with this architecture"
		(exclude_from_sim no)
		(at 68.834 273.812 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5590f0cb-cec2-4541-be47-4630e4619f52")
	)
	(text "Make pin headers stackable, female on bottom, \nmale on top. With CS going to each stacked one."
		(exclude_from_sim no)
		(at 95.25 -44.45 0)
		(effects
			(font
				(size 3.81 3.81)
			)
		)
		(uuid "647ad581-8b34-4741-bf05-b2118fed9092")
	)
